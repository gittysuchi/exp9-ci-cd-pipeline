{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run all tests",
      "type": "shell",
      "command": "mvn -B clean verify",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "2. Run the application (http://localhost:8080)",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "3. Build Docker image",
      "type": "shell",
      "command": "docker build -t exp9-cicd-demo:local .",
      "problemMatcher": []
    },
    {
      "label": "4. Run Docker image (http://localhost:8080)",
      "type": "shell",
      "command": "docker run --rm -p 8080:8080 exp9-cicd-demo:local",
      "problemMatcher": []
    },
    {
      "label": "5. Push to GitHub (Windows PowerShell)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File scripts/push-to-github.ps1",
      "problemMatcher": []
    },
    {
      "label": "5. Push to GitHub (bash)",
      "type": "shell",
      "command": "bash scripts/push-to-github.sh",
      "problemMatcher": []
    }
  ]
}
